<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1080, height=1920">
    <title>FitAdmi — El Desafío de los 5 Minutos</title>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js" integrity="sha384-sG0Hv1tP1lZCk9KQmrIbY/XNwi+OY84GQqhMscbnsoBFqAz8KNCil1kvfL3Hbbk2" crossorigin="anonymous"></script>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        width: 1080px;
        height: 1920px;
        overflow: hidden;
        background: #09090B;
      }
      #root {
        position: relative;
        width: 1080px;
        height: 1920px;
        overflow: hidden;
        background: #09090B;
      }
      .scene {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }
    </style>
  </head>
  <body>
    <div data-hf-id="hf-coex" id="root" data-composition-id="main" data-start="0" data-duration="29.0" data-width="1080" data-height="1920">
      <!-- ── SCENES ── -->
      <!-- 01: Hook - Cronómetro desafío 5 min -->
      <div data-hf-id="hf-3x7g" id="el-01-hook" class="scene" data-composition-id="01-hook" data-composition-src="compositions/frames/01-hook.html" data-start="0" data-duration="3.8" data-track-index="0"></div>

      <!-- 02: Paso 1 - Planes y Entrenadores -->
      <div data-hf-id="hf-u0dp" id="el-02-planes" class="scene" data-composition-id="02-planes" data-composition-src="compositions/frames/02-planes.html" data-start="3.6" data-duration="3.8" data-track-index="1"></div>

      <!-- 03: Paso 2 - Carga de Clientes (Modal animado) -->
      <div data-hf-id="hf-l233" id="el-03-clientes" class="scene" data-composition-id="03-clientes" data-composition-src="compositions/frames/03-clientes.html" data-start="7.2" data-duration="4.2" data-track-index="0"></div>

      <!-- 04: Paso 3 - Productos y Stock -->
      <div data-hf-id="hf-unck" id="el-04-stock" class="scene" data-composition-id="04-stock" data-composition-src="compositions/frames/04-stock.html" data-start="11.2" data-duration="4.2" data-track-index="1"></div>

      <!-- 05: Paso 4 - Control de Caja -->
      <div data-hf-id="hf-c5cj" id="el-05-caja" class="scene" data-composition-id="05-caja" data-composition-src="compositions/frames/05-caja.html" data-start="15.2" data-duration="4.3" data-track-index="0"></div>

      <!-- 06: Paso 5 - Todo Organizado / Dashboard -->
      <div data-hf-id="hf-c6or" id="el-06-organizado" class="scene" data-composition-id="06-organizado" data-composition-src="compositions/frames/06-organizado.html" data-start="19.3" data-duration="5.1" data-track-index="1"></div>

      <!-- 07: CTA - Desafío completado 04:59 -->
      <div data-hf-id="hf-flgc" id="el-07-cta" class="scene" data-composition-id="07-cta" data-composition-src="compositions/frames/07-cta.html" data-start="24.2" data-duration="4.8" data-track-index="0"></div>

      <!-- ── AUDIO TRACKS ── -->
      <!-- Música de fondo: Beat de entrenamiento dinámico -->
      <audio data-hf-id="hf-xb5h" id="bgm" class="clip" src="assets/audio/bgm-beat.mp3" data-start="0" data-duration="29.0" data-volume="0.095499"></audio>

      <!-- ── SFX SINCRONIZADOS ── -->
      <!-- SFX Frame 1: Impacto inicial -->
      <audio data-hf-id="hf-1pg5" id="sfx-impact" class="clip" src="assets/audio/impact-bass-1.mp3" data-start="0.05" data-duration="1.2" data-volume="0.55"></audio>

      <!-- SFX Transición 1 -> 2: Whoosh + Click de guardado de plan -->
      <audio data-hf-id="hf-4wwr" id="sfx-whoosh-1" class="clip" src="assets/audio/whoosh-short.mp3" data-start="3.55" data-duration="0.4" data-volume="0.45"></audio>
      <audio data-hf-id="hf-shmz" id="sfx-click-plan" class="clip" src="assets/audio/click.mp3" data-start="4.45" data-duration="0.3" data-volume="0.6"></audio>

      <!-- SFX Transición 2 -> 3: Whoosh + Tipeo modal + Click submit + Toast ping -->
      <audio data-hf-id="hf-zs0w" id="sfx-whoosh-2" class="clip" src="assets/audio/whoosh-short.mp3" data-start="7.15" data-duration="0.4" data-volume="0.45"></audio>
      <audio data-hf-id="hf-tp01" id="sfx-typing" class="clip" src="assets/audio/typing.mp3" data-start="7.9" data-duration="1.50" data-volume="0.4"></audio>
      <audio data-hf-id="hf-3q8x" id="sfx-click-cliente" class="clip" src="assets/audio/click.mp3" data-start="9.7" data-duration="0.3" data-volume="0.6"></audio>
      <audio data-hf-id="hf-v45r" id="sfx-toast-ping" class="clip" src="assets/audio/ping.mp3" data-start="10.0" data-duration="1.0" data-volume="0.7"></audio>

      <!-- SFX Transición 3 -> 4: Whoosh a Stock -->
      <audio data-hf-id="hf-i148" id="sfx-whoosh-3" class="clip" src="assets/audio/whoosh-short.mp3" data-start="11.15" data-duration="0.4" data-volume="0.45"></audio>

      <!-- SFX Transición 4 -> 5: Whoosh a Caja Diaria -->
      <audio data-hf-id="hf-sw04" id="sfx-whoosh-4" class="clip" src="assets/audio/whoosh-short.mp3" data-start="15.15" data-duration="0.4" data-volume="0.45"></audio>

      <!-- SFX Transición 5 -> 6: Whoosh a Asistencia / Todo Organizado -->
      <audio data-hf-id="hf-sw05" id="sfx-whoosh-5" class="clip" src="assets/audio/whoosh-short.mp3" data-start="19.25" data-duration="0.4" data-volume="0.45"></audio>
      <audio data-hf-id="hf-chkp" id="sfx-checkin-ping" class="clip" src="assets/audio/ping.mp3" data-start="20.0" data-duration="1.0" data-volume="0.7"></audio>

      <!-- SFX Transición 6 -> 7: Whoosh a CTA + Chime de Desafío Completado -->
      <audio data-hf-id="hf-hvyr" id="sfx-whoosh-6" class="clip" src="assets/audio/whoosh-short.mp3" data-start="24.15" data-duration="0.4" data-volume="0.45"></audio>
      <audio data-hf-id="hf-a29n" id="sfx-cta-chime" class="clip" src="assets/audio/chime.mp3" data-start="24.35" data-duration="1.8" data-volume="0.75"></audio>
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      window.__timelines["main"] = gsap.timeline({ paused: true });

      (function () {
        var tl = window.__timelines["main"];
        // Transición 1 -> 2
        tl.to("#el-01-hook", { opacity: 0, duration: 0.25, ease: "power2.inOut" }, 3.6);
        tl.fromTo("#el-02-planes", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "power2.inOut" }, 3.6);

        // Transición 2 -> 3
        tl.to("#el-02-planes", { opacity: 0, duration: 0.25, ease: "power2.inOut" }, 7.2);
        tl.fromTo("#el-03-clientes", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "power2.inOut" }, 7.2);

        // Transición 3 -> 4
        tl.to("#el-03-clientes", { opacity: 0, duration: 0.25, ease: "power2.inOut" }, 11.2);
        tl.fromTo("#el-04-stock", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "power2.inOut" }, 11.2);

        // Transición 4 -> 5
        tl.to("#el-04-stock", { opacity: 0, duration: 0.25, ease: "power2.inOut" }, 15.2);
        tl.fromTo("#el-05-caja", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "power2.inOut" }, 15.2);

        // Transición 5 -> 6
        tl.to("#el-05-caja", { opacity: 0, duration: 0.25, ease: "power2.inOut" }, 19.3);
        tl.fromTo("#el-06-organizado", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "power2.inOut" }, 19.3);

        // Transición 6 -> 7
        tl.to("#el-06-organizado", { opacity: 0, duration: 0.25, ease: "power2.inOut" }, 24.2);
        tl.fromTo("#el-07-cta", { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "power2.inOut" }, 24.2);

        // Anclaje total 29.0 segundos
        tl.to({}, { duration: 29.0 }, 0);
      })();
    </script>
  </body>
</html>
